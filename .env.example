# Telegram bot
BOT_TOKEN=123456:replace_me
ADMIN_TELEGRAM_ID=123456789

# PostgreSQL
POSTGRES_DB=social_monitor
POSTGRES_USER=social_monitor
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://social_monitor:change_me@postgres:5432/social_monitor

# Generate with: python scripts/generate_key.py
APP_ENCRYPTION_KEY=replace_with_fernet_key

# Scheduling
DEFAULT_POLL_INTERVAL_SECONDS=120
MIN_POLL_INTERVAL_SECONDS=30
SCHEDULER_TICK_SECONDS=2
JOB_LEASE_SECONDS=300
MAX_JOB_ATTEMPTS=8
MAX_CREDENTIAL_TRIES_PER_SOURCE=5

# Worker sizing
VK_WORKER_CONCURRENCY=6
TG_MAX_ACTIVE_ACCOUNTS=20
DELIVERY_CONCURRENCY=1
DELIVERY_BATCH_SIZE=0

# Safety windows
VK_PAGE_SIZE=100
VK_MAX_PAGES_PER_RUN=20
VK_PER_TOKEN_MIN_INTERVAL_SECONDS=0.35
TG_BATCH_MESSAGES=500
CREDENTIAL_HEALTH_PROBE_POSTS=5
COLLECTION_OVERLAP_SECONDS=120
MEDIA_MAX_PREVIEWS_PER_ITEM=4
MEDIA_MAX_PREVIEW_BYTES=2000000
MEDIA_MAX_IMAGE_EDGE=1280
MEDIA_RETENTION_HOURS=24
MEDIA_DELETE_AFTER_DELIVERY=true
JOB_HISTORY_DAYS=7
DELIVERY_HISTORY_DAYS=30

# Proxy health
IP_CHECK_URL=https://ipwho.is/
TG_REQUIRE_NON_RU=true
PROXY_FAILURES_TO_QUARANTINE=1
PROXY_FAILURES_TO_REMOVE=5
PROXY_QUARANTINE_MINUTES=15
PROXY_REMOVE_AFTER_HOURS=3
PROXY_LOW_RATIO=0.5
PROXY_LOW_WATERMARK=1
ALERT_COOLDOWN_MINUTES=30
HEALTH_ALERT_REPEAT_MINUTES=360
LIMITED_ALERT_THRESHOLD_SECONDS=1800
DAILY_REPORT_HOUR_MOSCOW=0
DAILY_REPORT_TOP_SOURCES=5

# VK
VK_API_VERSION=5.131
VK_API_BASE=https://api.vk.com/method

# Paths
MEDIA_ROOT=/app/data/media
LOG_LEVEL=INFO
